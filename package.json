{
  "name": "zotero-mcp",
  "version": "0.1.0",
  "description": "Zotero MCP server with 82 tools, for online Zotero libraries. stdio or streamable HTTP.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zotero",
    "reference-manager",
    "citations",
    "ai",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4965898/zotero-online-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/4965898/zotero-online-mcp/issues"
  },
  "homepage": "https://github.com/4965898/zotero-online-mcp#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "zotero-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "stdio": "npm run build && node --env-file-if-exists=.env dist/stdio.js",
    "setup:local": "node scripts/setup-local.mjs",
    "address": "node scripts/show-address.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "docs:tools": "npm run build && node scripts/tool-docs.mjs",
    "setup": "node scripts/init-env.mjs",
    "test:live": "npm run build && node --env-file-if-exists=.env scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@citation-js/core": "0.8.2",
    "@citation-js/plugin-bibtex": "0.8.2",
    "@citation-js/plugin-ris": "0.8.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pdfjs-dist": "6.3.289",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
