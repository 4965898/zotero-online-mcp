# Copy to .env; never commit secrets.
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=data/service.sqlite
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ENABLE_WRITES=true
# Set a long invitation code before offering a private hosted instance.
SIGNUP_SECRET=
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
MAX_SESSIONS=500
SESSION_TTL_MINUTES=30
MAX_FILE_MB=20
# Service access/refresh token lifetime in days. 0 (default) issues tokens that never expire.
# They stay valid until revoked on the landing page or deleted with the connection. Set a positive
# number only if you host a shared instance and want automatic credential expiry.
TOKEN_TTL_DAYS=0
# Let clients authenticate with their Zotero API key directly instead of a service token. Simplest
# for a single-user instance: the client config holds the Zotero key and nothing else. Trade-offs:
# the key is copied into every client, and revoking one device means revoking the Zotero key itself.
# Keep this false if several people share the instance.
PASSTHROUGH_KEYS=false
# Optional embedding endpoint; disabled unless URL and MODEL are configured.
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional live read-only smoke test. Use a dedicated test key, never your primary key.
ZOTERO_TEST_API_KEY=
ZOTERO_TEST_GROUP_ID=
# Used by compose.production.yml (also set PUBLIC_URL=https://this-domain)
DOMAIN=mcp.example.com
