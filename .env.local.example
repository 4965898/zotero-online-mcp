# Copy to .env for local (stdio) use. Never commit this file.

# Required. Create one at https://www.zotero.org/settings/keys/new
# Tick "Allow library access" and "Allow write access" only if you want the AI to modify your library.
ZOTERO_API_KEY=

# Optional. Your numeric Zotero user ID. Leave empty and the server looks it up from the key above.
ZOTERO_USER_ID=

# Optional. Set true to expose the 31 write tools. They still preview every change first.
ZOTERO_WRITE=false

# Optional. Attachment download limit in MB.
MAX_FILE_MB=20

# Optional semantic search ("find similar"). Needs all three, URL must be HTTPS.
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
